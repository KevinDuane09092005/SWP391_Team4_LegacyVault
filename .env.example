# Cấu hình kết nối Backend Spring Boot API
# Để trống VITE_API_BASE_URL để sử dụng Vite Proxy tự động chuyển tiếp /api sang http://localhost:8080 (Tránh lỗi CORS)
VITE_API_BASE_URL=

# false: Gọi trực tiếp API Backend thực tế (Flows 1-7)
# true: Sử dụng dữ liệu Mock nội bộ cho trình diễn offline
VITE_DEMO_MODE=false

# Chatbot: "api" calls the authenticated Spring Boot chatbot endpoints.
# The OpenAI API key belongs only in the backend environment, never in this file.
VITE_CHAT_API_MODE=api
